{
  "id": "batch-production",
  "version": "1.0.0",
  "stages": ["rule-readiness", "batch-launch", "feature-work", "item-acceptance", "release-review", "user-acceptance", "batch-close", "batch-release"],
  "quality": { "blockingSeverities": ["P0", "P1", "P2", "P3"], "allowCurrentDebt": false },
  "concurrency": { "maxLogicalItems": 10, "physicalConcurrency": "min(user-limit,runtime-capacity,conflict-free-eligible-features)" },
  "barriers": ["previous-batch-closed", "user-batch-launch-decision"],
  "acceptance": ["item-harness-acceptance", "independent-release-review", "user-item-acceptance", "user-batch-close-decision"]
}
