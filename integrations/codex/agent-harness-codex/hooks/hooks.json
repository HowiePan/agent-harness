{
  "description": "Resolve explicit project aliases and fixed Agent Harness locations for short pseudo-commands, including read-only h:where.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/hooks/pseudo-command-router.mjs\"",
            "commandWindows": "node \"%PLUGIN_ROOT%\\hooks\\pseudo-command-router.mjs\"",
            "timeout": 5,
            "additionalContextLimit": 1200
          }
        ]
      }
    ]
  }
}
