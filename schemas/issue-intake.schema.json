{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-harness.local/schemas/issue-intake.schema.json",
  "title": "Agent Harness Conversation Issue Intake",
  "type": "object",
  "required": ["protocolVersion", "projectAlias", "project", "observedAt", "summary", "severity", "expected", "actual", "reproduction", "conversation", "sanitization"],
  "properties": {
    "protocolVersion": { "const": "1.0" },
    "projectAlias": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$" },
    "workspace": { "type": "object", "required": ["workspaceId", "alias", "projectIds"], "properties": { "workspaceId": { "type": "string", "minLength": 1 }, "alias": { "type": "string", "minLength": 1 }, "revision": { "type": "integer", "minimum": 1 }, "descriptorDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "projectIds": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true } }, "additionalProperties": false },
    "workflow": { "type": "object", "required": ["id", "version", "artifactDigest"], "properties": { "id": { "type": "string", "minLength": 1 }, "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" }, "artifactDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "runId": { "type": "string", "minLength": 1 } }, "additionalProperties": false },
    "project": {
      "type": "object",
      "required": ["projectId", "profileId", "extensionId"],
      "properties": {
        "projectId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "profileId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "extensionId": { "type": "string", "minLength": 1, "maxLength": 128 }
      },
      "additionalProperties": false
    },
    "observedAt": { "type": "string", "format": "date-time" },
    "summary": { "type": "string", "minLength": 1, "maxLength": 512, "pattern": "^[^\\r\\n\\u0000-\\u001f]+$" },
    "severity": { "enum": ["P0", "P1", "P2", "P3", "unclassified"] },
    "environment": { "type": "object" },
    "expected": {},
    "actual": {},
    "reproduction": {
      "type": "object",
      "required": ["steps"],
      "properties": {
        "steps": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1, "maxLength": 2048 } }
      },
      "additionalProperties": true
    },
    "conversation": {
      "type": "object",
      "required": ["source", "excerpts"],
      "properties": {
        "source": { "const": "current-thread" },
        "excerpts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["role", "text"],
            "properties": {
              "role": { "enum": ["user", "assistant", "tool"] },
              "text": { "type": "string", "minLength": 1, "maxLength": 20000 }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "missingEvidence": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 256 } },
    "correlation": {
      "type": "object",
      "required": ["category", "failureCode", "scope"],
      "properties": {
        "category": { "type": "string", "minLength": 1, "maxLength": 128 },
        "failureCode": { "type": "string", "minLength": 1, "maxLength": 128 },
        "scope": { "type": "string", "minLength": 1, "maxLength": 256 }
      },
      "additionalProperties": false
    },
    "incidentFingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "sanitization": {
      "type": "object",
      "required": ["confirmed", "removed"],
      "properties": {
        "confirmed": { "const": true },
        "removed": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 256 } }
      },
      "additionalProperties": false
    },
    "intakeDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "additionalProperties": false
}
