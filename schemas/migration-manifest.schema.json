{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-harness.local/schemas/migration-manifest.schema.json",
  "title": "Agent Harness Legacy Migration Manifest",
  "type": "object",
  "required": ["protocolVersion", "importer", "kind", "legacyRoot", "sourceDigest", "fileCount", "facts", "allowedDispositions", "assessmentDigest"],
  "properties": {
    "protocolVersion": { "const": "1.0" },
    "importer": { "type": "object", "required": ["id", "version"], "properties": { "id": { "type": "string", "minLength": 1 }, "version": { "type": "string", "minLength": 1 } }, "additionalProperties": false },
    "sourceDigest": { "$ref": "#/$defs/digest" },
    "kind": { "type": "string", "minLength": 1 },
    "legacyRoot": { "type": "string", "minLength": 1 },
    "fileCount": { "type": "integer", "minimum": 0 },
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "disposition", "reason", "sourceSha256"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "disposition": { "enum": ["verified-current", "stale-revalidate", "log-only", "invalid", "superseded", "legacy-only"] },
          "reason": { "type": "string", "minLength": 1 },
          "sourceSha256": { "$ref": "#/$defs/digest" },
          "count": { "type": "integer", "minimum": 0 },
          "status": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
          "protocol": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
          "version": { "anyOf": [{ "type": "string" }, { "type": "number" }, { "type": "null" }] }
        },
        "additionalProperties": false
      }
    },
    "allowedDispositions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["verified-current", "stale-revalidate", "log-only", "invalid", "superseded", "legacy-only"] }
    },
    "assessmentDigest": { "$ref": "#/$defs/digest" }
  },
  "additionalProperties": false,
  "$defs": { "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" } }
}
