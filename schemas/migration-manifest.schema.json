{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-harness.local/schemas/migration-manifest.schema.json",
  "title": "Agent Harness Legacy Migration Manifest",
  "type": "object",
  "required": ["protocolVersion", "importer", "sourceDigest", "assessmentDigest", "facts"],
  "properties": {
    "protocolVersion": { "const": "1.0" },
    "importer": { "type": "object", "required": ["id", "version"], "properties": { "id": { "type": "string", "minLength": 1 }, "version": { "type": "string", "minLength": 1 } }, "additionalProperties": false },
    "sourceDigest": { "$ref": "#/$defs/digest" },
    "assessmentDigest": { "$ref": "#/$defs/digest" },
    "facts": { "type": "array", "items": { "type": "object", "required": ["id", "disposition", "reason"], "properties": { "id": { "type": "string" }, "disposition": { "enum": ["verified-current", "stale-revalidate", "log-only", "invalid", "superseded", "legacy-only"] }, "reason": { "type": "string" } }, "additionalProperties": true } },
    "dispositionSummary": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } }
  },
  "additionalProperties": true,
  "$defs": { "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" } }
}
