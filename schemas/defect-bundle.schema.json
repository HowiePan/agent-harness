{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-harness.local/schemas/defect-bundle.schema.json",
  "title": "Agent Harness Sanitized Defect Bundle",
  "type": "object",
  "required": ["protocolVersion", "harness", "extensions", "descriptorDigest", "command", "authorityRevision", "expected", "actual", "reproduction", "sanitization", "bundleDigest"],
  "properties": {
    "protocolVersion": { "const": "1.0" },
    "harness": {
      "type": "object",
      "required": ["version", "artifactDigest"],
      "properties": {
        "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
        "artifactDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "commit": { "type": "string" }
      },
      "additionalProperties": false
    },
    "extensions": { "type": "array", "items": { "$ref": "project-descriptor.schema.json#/$defs/extensionIdentity" } },
    "descriptorDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "command": { "type": "object" },
    "authorityRevision": { "type": "integer", "minimum": 0 },
    "dispatchIds": { "type": "array", "items": { "type": "string" } },
    "evidenceRefs": { "type": "array", "items": { "type": "string" } },
    "expected": {},
    "actual": {},
    "reproduction": { "type": "object" },
    "sanitization": {
      "type": "object",
      "required": ["confirmed"],
      "properties": { "confirmed": { "const": true }, "removed": { "type": "array", "items": { "type": "string" } } },
      "additionalProperties": false
    },
    "bundleDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "additionalProperties": false
}
