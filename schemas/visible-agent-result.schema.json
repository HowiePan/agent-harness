{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-harness.local/schemas/visible-agent-result.schema.json",
  "title": "Agent Harness Visible Agent Result v1",
  "type": "object",
  "required": ["status", "summary", "changedFiles"],
  "properties": {
    "status": { "enum": ["completed", "blocked", "failed"] },
    "summary": { "type": "string", "minLength": 1 },
    "outputs": { "type": "object", "additionalProperties": { "type": "object", "required": ["schemaId", "value", "evidenceRefs"], "properties": { "schemaId": { "type": "string", "minLength": 1 }, "value": { "type": "object" }, "evidenceRefs": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } } }, "additionalProperties": false } },
    "checkpoints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "status", "summary", "evidence"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "status": { "type": "string", "minLength": 1 },
          "summary": { "type": "string", "minLength": 1 },
          "evidence": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        },
        "additionalProperties": false
      }
    },
    "made": { "type": "array", "items": { "type": "string" } },
    "notMade": { "type": "array", "items": { "type": "string" } },
    "changedFiles": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "observations": { "type": "array", "items": { "type": "string" } },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "severity", "summary"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "severity": { "enum": ["P0", "P1", "P2", "P3"] },
          "summary": { "type": "string", "minLength": 1 },
          "evidence": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "affectedPaths": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "symbols": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "contracts": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "generatedOutputs": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "conflictKeys": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
        },
        "additionalProperties": false
      }
    },
    "knownFindingDispositions": { "type": "array", "items": { "type": "object", "required": ["id", "disposition", "evidence"], "properties": { "id": { "type": "string", "minLength": 1 }, "disposition": { "enum": ["open", "not-reproduced"] }, "evidence": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } } }, "additionalProperties": false } },
    "followUpFeatures": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "acceptance", "allowedPaths", "forbiddenPaths", "dependsOn", "symbols", "contracts", "generatedOutputs", "conflictKeys"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "acceptance": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "allowedPaths": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "forbiddenPaths": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "dependsOn": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "symbols": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "contracts": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "generatedOutputs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "conflictKeys": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        },
        "additionalProperties": false
      }
    },
    "failureClass": { "type": ["string", "null"] },
    "blocker": {
      "anyOf": [
        { "type": "object", "required": ["kind", "summary"], "properties": { "kind": { "type": "string" }, "summary": { "type": "string" }, "resumeWhen": { "type": ["string", "null"] }, "code": { "type": "string" } }, "additionalProperties": false },
        { "type": "null" }
      ]
    }
  },
  "additionalProperties": false
}
