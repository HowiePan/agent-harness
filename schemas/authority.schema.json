{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-harness.local/schemas/authority.schema.json",
  "title": "Agent Harness Authority State",
  "type": "object",
  "required": ["protocolVersion", "projectId", "runId", "revision", "epoch", "generation", "status", "sourceDigest", "policyDigest", "pluginSetDigest", "features", "dispatches", "leases", "attempts", "submissions", "gates", "findings", "decisions", "receipts", "events"],
  "properties": {
    "protocolVersion": { "const": "1.0" },
    "projectId": { "$ref": "#/$defs/id" },
    "runId": { "$ref": "#/$defs/id" },
    "revision": { "type": "integer", "minimum": 1 },
    "epoch": { "type": "integer", "minimum": 1 },
    "generation": { "type": "integer", "minimum": 1 },
    "status": { "enum": ["ready", "running", "ready-to-close", "closure-blocked", "all-remaining-blocked", "closed"] },
    "sourceDigest": { "$ref": "#/$defs/digest" },
    "policyDigest": { "$ref": "#/$defs/digest" },
    "pluginSetDigest": { "$ref": "#/$defs/digest" },
    "artifactDigest": { "anyOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }] },
    "profile": { "type": "object", "required": ["id", "version", "config"], "properties": { "id": { "$ref": "#/$defs/id" }, "version": { "type": "string" }, "config": { "type": "object" } }, "additionalProperties": false },
    "features": { "type": "array", "items": { "$ref": "feature.schema.json" } },
    "dispatches": { "type": "array", "items": { "$ref": "#/$defs/dispatch" } },
    "leases": { "type": "array", "items": { "$ref": "#/$defs/lease" } },
    "attempts": { "type": "object", "additionalProperties": { "$ref": "#/$defs/attempt" } },
    "submissions": { "type": "array", "items": { "$ref": "#/$defs/submission" } },
    "evidenceRefs": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "gates": { "type": "array", "items": { "$ref": "#/$defs/gate" } },
    "findings": { "type": "array", "items": { "$ref": "#/$defs/finding" } },
    "decisions": { "type": "array", "items": { "$ref": "#/$defs/decision" } },
    "receipts": { "type": "array", "items": { "$ref": "#/$defs/receipt" } },
    "events": { "type": "array", "items": { "$ref": "#/$defs/event" } },
    "metadata": { "type": "object" }
  },
  "additionalProperties": true,
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "dispatch": { "type": "object", "required": ["dispatchId", "featureId", "epoch", "generation", "sourceDigest", "packetDigest", "outputRef", "status"], "properties": { "dispatchId": { "$ref": "#/$defs/id" }, "featureId": { "$ref": "#/$defs/id" }, "epoch": { "type": "integer", "minimum": 1 }, "generation": { "type": "integer", "minimum": 1 }, "sourceDigest": { "$ref": "#/$defs/digest" }, "packetDigest": { "$ref": "#/$defs/digest" }, "outputRef": { "type": "string" }, "status": { "enum": ["requested", "assigned", "committed", "superseded"] } }, "additionalProperties": true },
    "lease": { "type": "object", "required": ["leaseId", "dispatchId", "featureId", "agentId", "epoch", "generation", "status", "packetDigest", "outputRef"], "properties": { "leaseId": { "$ref": "#/$defs/id" }, "dispatchId": { "$ref": "#/$defs/id" }, "featureId": { "$ref": "#/$defs/id" }, "agentId": { "$ref": "#/$defs/id" }, "epoch": { "type": "integer", "minimum": 1 }, "generation": { "type": "integer", "minimum": 1 }, "status": { "enum": ["active", "committed", "superseded"] }, "packetDigest": { "$ref": "#/$defs/digest" }, "outputRef": { "type": "string" } }, "additionalProperties": true },
    "attempt": { "type": "object", "required": ["key", "logicalRoot", "failureClass", "failures", "limit", "records"], "properties": { "key": { "type": "string" }, "logicalRoot": { "type": "string" }, "failureClass": { "type": "string" }, "failures": { "type": "integer", "minimum": 0 }, "limit": { "type": "integer", "minimum": 1 }, "exhausted": { "type": "boolean" }, "records": { "type": "array", "items": { "type": "object" } } }, "additionalProperties": false },
    "submission": { "type": "object", "required": ["submissionId", "dispatchId", "leaseId", "featureId", "agentId", "epoch", "generation", "inputSourceDigest", "outputSourceDigest", "result", "evidenceRefs", "submissionDigest"], "properties": { "submissionId": { "$ref": "#/$defs/id" }, "dispatchId": { "$ref": "#/$defs/id" }, "leaseId": { "$ref": "#/$defs/id" }, "featureId": { "$ref": "#/$defs/id" }, "agentId": { "$ref": "#/$defs/id" }, "epoch": { "type": "integer", "minimum": 1 }, "generation": { "type": "integer", "minimum": 1 }, "inputSourceDigest": { "$ref": "#/$defs/digest" }, "outputSourceDigest": { "$ref": "#/$defs/digest" }, "result": { "$ref": "result.schema.json" }, "evidenceRefs": { "type": "array", "items": { "type": "string" } }, "submissionDigest": { "$ref": "#/$defs/digest" } }, "additionalProperties": true },
    "gate": { "type": "object", "required": ["id", "status", "specDigest", "sourceDigest", "toolchainDigest", "evidenceRefs"], "properties": { "id": { "$ref": "#/$defs/id" }, "status": { "enum": ["passed", "failed", "environment-failed"] }, "specDigest": { "$ref": "#/$defs/digest" }, "sourceDigest": { "$ref": "#/$defs/digest" }, "toolchainDigest": { "$ref": "#/$defs/digest" }, "evidenceRefs": { "type": "array", "minItems": 1, "items": { "type": "string" } }, "forcedFresh": { "type": "boolean" } }, "additionalProperties": true },
    "finding": { "type": "object", "required": ["id", "severity", "summary", "status"], "properties": { "id": { "$ref": "#/$defs/id" }, "severity": { "enum": ["P0", "P1", "P2", "P3"] }, "summary": { "type": "string", "minLength": 1 }, "status": { "enum": ["open", "resolved"] } }, "additionalProperties": true },
    "decision": { "type": "object", "required": ["id", "actor", "decision"], "properties": { "id": { "$ref": "#/$defs/id" }, "actor": { "type": "string", "minLength": 1 }, "decision": { "type": "string", "minLength": 1 }, "digest": { "$ref": "#/$defs/digest" } }, "additionalProperties": true },
    "receipt": { "type": "object", "required": ["digest"], "properties": { "digest": { "$ref": "#/$defs/digest" }, "type": { "type": "string" }, "ref": { "type": "string" } }, "additionalProperties": true },
    "event": { "type": "object", "required": ["sequence", "type", "at", "epoch", "generation"], "properties": { "sequence": { "type": "integer", "minimum": 1 }, "type": { "type": "string" }, "at": { "type": "string", "format": "date-time" }, "epoch": { "type": "integer", "minimum": 1 }, "generation": { "type": "integer", "minimum": 1 } }, "additionalProperties": true }
  }
}
