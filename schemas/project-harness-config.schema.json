{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-harness.local/schemas/project-harness-config.schema.json",
  "title": "Agent Harness Consumer Project Configuration",
  "type": "object",
  "required": ["schemaVersion", "kind", "extensions", "project", "binding"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "enum": ["1.0", "1.1"] },
    "kind": { "const": "agent-harness-project" },
    "extensions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "version", "module"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]+$" },
          "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
          "module": { "type": "string", "minLength": 1, "maxLength": 1024 }
        },
        "additionalProperties": false
      }
    },
    "project": {
      "type": "object",
      "required": ["generatorExtensionId", "input"],
      "properties": {
        "generatorExtensionId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]+$" },
        "fileBoundary": { "type": "object", "required": ["version","sourceRoots","sharedPaths","artifactRoots","protectedPaths"], "properties": { "version": {"const":"project-boundary/1"}, "sourceRoots":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}}, "sharedPaths":{"type":"array","items":{"type":"string","minLength":1}}, "artifactRoots":{"type":"array","items":{"type":"string","minLength":1}}, "protectedPaths":{"type":"array","items":{"type":"string","minLength":1}} }, "additionalProperties":false },
        "input": { "type": "object" }
      },
      "additionalProperties": false
    },
    "binding": {
      "type": "object",
      "required": ["projectId", "profileId", "extensionId", "workspaceRoot"],
      "properties": {
        "alias": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$" },
        "projectId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "profileId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "extensionId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "workspaceRoot": { "type": "string", "minLength": 1, "maxLength": 1024 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
