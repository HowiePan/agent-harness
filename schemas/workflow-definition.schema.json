{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-harness.local/schemas/workflow-definition.schema.json",
  "title": "Agent Harness Workflow Definition",
  "type": "object",
  "required": ["id", "version", "profileId", "routes"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "artifactDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "id": { "$ref": "#/$defs/id" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "profileId": { "$ref": "#/$defs/id" },
    "routes": {
      "type": "object",
      "additionalProperties": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/node" } }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9.-]*$" },
    "node": {
      "type": "object",
      "required": ["id", "template", "task"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "template": { "$ref": "#/$defs/id" },
        "task": { "$ref": "node-task-contract.schema.json" },
        "dependsOn": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "forEach": { "$ref": "#/$defs/id" },
        "action": { "type": "string", "minLength": 1 },
        "stage": { "type": "string", "minLength": 1 },
        "readOnly": { "type": "boolean" },
        "qualityReview": { "type": "boolean" },
        "portKey": { "type": "string", "minLength": 1 },
        "outputPorts": { "type": "object", "additionalProperties": { "type": "string" } },
        "outputValueSchemas": { "type": "object", "additionalProperties": { "type": "object" } },
        "outputChecks": { "type": "array", "items": { "$ref": "#/$defs/outputCheck" } },
        "expectedHit": { "type": "boolean" },
        "outputPath": { "type": "string" }
      },
      "additionalProperties": true
    },
    "outputCheck": {
      "type": "object",
      "required": ["portId", "path", "operator"],
      "properties": {
        "portId": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "operator": { "enum": ["equals", "non-empty", "output-path"] },
        "value": {}
      },
      "additionalProperties": false
    }
  }
}
