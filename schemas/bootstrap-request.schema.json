{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-harness.local/schemas/bootstrap-request.schema.json",
  "title": "Agent Harness Bootstrap Request",
  "type": "object",
  "required": ["protocolVersion", "extensions", "project", "binding"],
  "properties": {
    "protocolVersion": { "const": "1.0" },
    "extensions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["id", "version", "module"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]+$" },
          "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
          "module": { "type": "string", "minLength": 1, "maxLength": 1024 }
        },
        "additionalProperties": false
      }
    },
    "project": {
      "type": "object",
      "required": ["generatorExtensionId", "input"],
      "properties": {
        "generatorExtensionId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]+$" },
        "input": { "type": "object" }
      },
      "additionalProperties": false
    },
    "binding": {
      "type": "object",
      "required": ["projectId", "profileId", "extensionId", "workspaceRoot"],
      "properties": {
        "projectId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "profileId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "extensionId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "workspaceRoot": { "type": "string", "minLength": 1, "maxLength": 1024 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
