{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-harness.local/schemas/feature.schema.json",
  "title": "Agent Harness Feature",
  "type": "object",
  "required": ["id", "acceptance", "dependsOn", "allowedPaths"],
  "properties": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$" },
    "kind": { "type": "string" },
    "ownerRole": { "type": "string" },
    "logicalRoot": { "type": "string" },
    "laneId": { "type": "string" },
    "acceptance": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "steps": { "type": "array", "items": { "type": "object", "required": ["id"], "properties": { "id": { "type": "string" }, "title": { "type": "string" } }, "additionalProperties": false } },
    "dependsOn": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "allowedPaths": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "forbiddenPaths": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "symbols": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "contracts": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "generatedOutputs": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "artifactInputs": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "artifactOutputs": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "conflictKeys": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "conflictsWith": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "gatePlan": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "attemptLimit": { "type": "integer", "minimum": 1 },
    "metadata": { "type": "object" }
    ,"state": { "enum": ["pending", "dispatched", "running", "completed", "blocked", "failed-budget", "cancelled"] }
    ,"submissionId": { "type": "string" }
    ,"blocker": { "type": "object" }
    ,"recoveryDisposition": { "type": "string" }
    ,"recoveryEvidenceRefs": { "type": "array", "items": { "type": "string" } }
    ,"reopenedAt": { "type": "string" }
    ,"reopenReason": { "type": "string" }
  },
  "additionalProperties": false
}
