{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-harness.local/schemas/recovery-verification.schema.json",
  "title": "Agent Harness Recovery Capsule Verification Receipt",
  "type": "object",
  "required": ["protocolVersion", "kind", "verifiedAt", "expiresAt", "capsuleRoot", "capsuleId", "capsuleManifestDigest", "importer", "sourceDigest", "assessmentDigest", "projectId", "runId", "authorityEpoch", "authorityGeneration", "targetEpoch", "fileCount", "totalBytes", "receiptDigest"],
  "properties": {
    "protocolVersion": { "const": "1.0" },
    "kind": { "const": "recovery-capsule-verification" },
    "verifiedAt": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" },
    "capsuleRoot": { "type": "string", "minLength": 1 },
    "capsuleId": { "type": "string", "minLength": 1 },
    "capsuleManifestDigest": { "$ref": "#/$defs/digest" },
    "importer": {
      "type": "object",
      "required": ["id", "version"],
      "properties": { "id": { "type": "string", "minLength": 1 }, "version": { "type": "string", "minLength": 1 } },
      "additionalProperties": false
    },
    "sourceDigest": { "$ref": "#/$defs/digest" },
    "assessmentDigest": { "$ref": "#/$defs/digest" },
    "projectId": { "type": "string", "minLength": 1 },
    "runId": { "type": "string", "minLength": 1 },
    "authorityEpoch": { "type": "integer", "minimum": 1 },
    "authorityGeneration": { "type": "integer", "minimum": 1 },
    "targetEpoch": { "type": "integer", "minimum": 2 },
    "fileCount": { "type": "integer", "minimum": 0 },
    "totalBytes": { "type": "integer", "minimum": 0 },
    "receiptDigest": { "$ref": "#/$defs/digest" }
  },
  "additionalProperties": false,
  "$defs": { "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" } }
}
