{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-harness.local/schemas/project-descriptor-input.schema.json",
  "title": "Agent Harness Project Descriptor Input",
  "type": "object",
  "$defs": {
    "extensionIdentity": {
      "type": "object",
      "required": ["id", "version", "digest"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]+$" },
        "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
        "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      },
      "additionalProperties": false
    }
  },
  "required": ["id", "harness", "workspace", "profiles"],
  "properties": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
    "harness": {
      "type": "object",
      "required": ["version", "artifactDigest"],
      "properties": {
        "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
        "artifactDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      },
      "additionalProperties": false
    },
    "workspace": {
      "type": "object",
      "required": ["root"],
      "properties": {
        "root": { "type": "string" },
        "remote": { "type": "string" },
        "rootSelector": { "type": "string" },
        "excluded": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "profiles": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "extensions": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/extensionIdentity" } },
    "policy": { "type": "object" },
    "gateRecipes": { "type": "array", "items": { "type": "object" } },
    "artifactProviders": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": false
}
