{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-harness.local/schemas/execution-readiness-report.schema.json",
  "title": "Agent Harness Execution Readiness Report",
  "type": "object",
  "required": ["protocolVersion", "kind", "planDigest", "lineageResolution", "project", "release", "checks", "executionReady", "createdAt", "expiresAt", "reportDigest"],
  "properties": {
    "protocolVersion": { "const": "1.0" },
    "kind": { "const": "execution-readiness-report" },
    "planDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "lineageResolution": { "anyOf": [{ "$ref": "run-lineage-resolution.schema.json" }, { "type": "null" }] },
    "project": {
      "type": "object",
      "required": ["id", "revision", "descriptorDigest"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "revision": { "type": "integer", "minimum": 1 },
        "descriptorDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      },
      "additionalProperties": false
    },
    "release": {
      "type": "object",
      "required": ["version", "artifactDigest", "active"],
      "properties": {
        "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
        "artifactDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "active": { "type": "boolean" },
        "runtimeRoot": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "ready", "issues"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "ready": { "type": "boolean" },
          "details": { "type": "object" },
          "issues": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["code", "message"],
              "properties": {
                "code": { "type": "string", "minLength": 1 },
                "message": { "type": "string", "minLength": 1 }
              },
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": false
      }
    },
    "writeProbe": {
      "type": "object",
      "required": ["attempted", "ready", "cleaned"],
      "properties": {
        "attempted": { "type": "boolean" },
        "ready": { "type": "boolean" },
        "cleaned": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "executionReady": { "type": "boolean" },
    "createdAt": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" },
    "reportDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "additionalProperties": false
}
