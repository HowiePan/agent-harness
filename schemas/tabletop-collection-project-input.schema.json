{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-harness.local/schemas/tabletop-collection-project-input.schema.json",
  "title": "Tabletop Collection Project Input",
  "type": "object",
  "properties": {
    "id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "harness": { "$ref": "delivery-project-input.schema.json#/$defs/harness" },
    "workspaceRoot": { "type": "string", "minLength": 1 },
    "remote": { "type": "string", "minLength": 1 },
    "runtimePluginId": { "$ref": "delivery-project-input.schema.json#/$defs/id" },
    "runtimePluginIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "delivery-project-input.schema.json#/$defs/id" } },
    "agentExecutionMode": { "enum": ["conversation-visible", "headless"] },
    "runtimeExtension": { "$ref": "delivery-project-input.schema.json#/$defs/extension" },
    "headlessRuntimeExtension": { "$ref": "delivery-project-input.schema.json#/$defs/extension" },
    "runtimeConfigs": { "type": "object", "additionalProperties": { "type": "object" } },
    "extensions": { "type": "array", "items": { "$ref": "delivery-project-input.schema.json#/$defs/extension" } },
    "model": { "type": "string", "minLength": 1 },
    "maxConcurrency": { "type": "integer", "minimum": 1 },
    "maxLogicalGames": { "type": "integer", "minimum": 1, "maximum": 100 },
    "batches": { "type": "array", "items": { "$ref": "#/$defs/batch" } }
  },
  "additionalProperties": false,
  "$defs": {
    "batch": {
      "type": "object",
      "required": ["id", "gameIds"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "ruleStatus": { "type": "string", "minLength": 1 },
        "gameIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      },
      "additionalProperties": false
    }
  }
}
