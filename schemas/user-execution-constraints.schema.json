{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-harness.local/schemas/user-execution-constraints.schema.json",
  "title": "User Execution Constraints",
  "type": "object",
  "required": ["protocolVersion", "kind", "source", "revision", "processBackedAgent", "unattended", "decisionLineage", "constraintDigest"],
  "properties": {
    "protocolVersion": { "const": "1.0" },
    "kind": { "const": "user-execution-constraints" },
    "source": { "type": "string", "minLength": 1 },
    "revision": { "type": "integer", "minimum": 1 },
    "processBackedAgent": { "enum": ["deny", "allow-explicit"] },
    "unattended": { "enum": ["deny", "allow-explicit"] },
    "decisionLineage": { "type": "string", "minLength": 1 },
    "constraintDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "additionalProperties": false
}
