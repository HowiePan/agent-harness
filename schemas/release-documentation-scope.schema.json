{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-harness.local/schemas/release-documentation-scope.schema.json",
  "title": "Project-owned release documentation scope",
  "type": "object",
  "required": ["schemaVersion", "documents", "directories"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "documents": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["main"],
        "properties": { "main": { "type": "string", "minLength": 1 }, "directory": { "type": "string", "minLength": 1 } },
        "additionalProperties": false
      }
    },
    "directories": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
  },
  "additionalProperties": false
}
